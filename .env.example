# Copiar a .env y ajustar. (Ojo: la versión "vulnerable" del proyecto no lee
# un .env — las credenciales están escritas en src/config.ts. Eso es justamente
# una de las falhas que hay que corregir.)

NODE_ENV=development
PORT=3000

# Puerto publicado en el host (docker-compose.yml)
APP_PORT=8080

DB_HOST=db
DB_PORT=5432
DB_NAME=origen
DB_USER=origen_app
DB_PASSWORD=origen_app_2024

UPLOADS_DIR=/app/uploads

# Contraseñas fuertes para los usuarios iniciales (solo entorno de desarrollo/práctica).
# Si se omiten en desarrollo, la app genera claves aleatorias temporales y las muestra en los logs.
ADMIN_PASSWORD=Cambiar_Admin_2024!#9x
VALENTINA_PASSWORD=Cambiar_Valentina_2024!#7k
BARISTA_PASSWORD=Cambiar_Barista_2024!#4m
MOZO_PASSWORD=Cambiar_Mozo_2024!#2p
CLIENTE_PASSWORD=Cambiar_Cliente_2024!#8q